<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="Grid.Main" TargetType="{x:Type Grid}">
        <Setter Property="Background" Value="#0B1220"></Setter>
    </Style>

    <Style x:Key="Grid.Panel" TargetType="{x:Type Grid}">
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
    </Style>

    <Style x:Key="Border.Panel" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="0, 16, 0, 16"/>
        <Setter Property="Background" Value="#101C2D"></Setter>
    </Style>

    <Style x:Key="Border.NavigationPanel" TargetType="{x:Type Border}" BasedOn="{StaticResource Border.Panel}">
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="Border.NavigationItem" TargetType="{x:Type Border}" BasedOn="{StaticResource Border.Panel}">
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Padding" Value="16, 0, 16, 0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Cursor" Value="Hand"></Setter>
        <Setter Property="Height" Value="56"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1D2D43"/>
                <Setter Property="BorderBrush" Value="#2684FF"></Setter>
                <Setter Property="BorderThickness" Value="2,0,0,0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextBlock" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E6EDF7"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="TextBlock.Banner" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextBlock}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="TextBlock.Navigation" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextBlock}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#94A9C5"></Setter>
    </Style>

    <Style x:Key="TextBlock.Hint" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextBlock}">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="#94A9C5"></Setter>
    </Style>

</ResourceDictionary>