<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">

    <SolidColorBrush x:Key="Background.Main" Color="#0B1220" />
    <SolidColorBrush x:Key="Background.Surface" Color="#111C2E" />

    <SolidColorBrush x:Key="Border" Color="#26364D"/>
    <SolidColorBrush x:Key="Border.Subtle" Color="#1C2A3E"/>

    <SolidColorBrush x:Key="Foreground.Primary" Color="#E8EEF7"/>
    <SolidColorBrush x:Key="Foreground.Secondary" Color="#A0AEC0"/>
    <SolidColorBrush x:Key="Foreground.Muted" Color="#718198"/>
    <SolidColorBrush x:Key="Foreground.Disabled" Color="#46556B"/>

    <SolidColorBrush x:Key="Background.Neutral" Color="#1C2A3D"/>
    <SolidColorBrush x:Key="Foreground.Neutral" Color="#B8C7D9"/>
    <SolidColorBrush x:Key="Border.Neutral" Color="#34465D"/>

    <SolidColorBrush x:Key="Background.Info" Color="#142E4D"/>
    <SolidColorBrush x:Key="Foreground.Info" Color="#70B5FF"/>
    <SolidColorBrush x:Key="Border.Info" Color="#2684FF"/>

    <SolidColorBrush x:Key="Background.Danger" Color="#3D2028"/>
    <SolidColorBrush x:Key="Foreground.Danger" Color="#FF8585"/>
    <SolidColorBrush x:Key="Border.Danger" Color="#EF4444"/>

    <SolidColorBrush x:Key="Background.Success" Color="#12372F"/>
    <SolidColorBrush x:Key="Foreground.Success" Color="#20A982"/>
    <SolidColorBrush x:Key="Border.Success" Color="#20D6A0"/>

    <Style x:Key="Panel.Main" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Background.Main}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="Section" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}"></Setter>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,16,0,16"/>
    </Style>

    <Style x:Key="Text" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Foreground.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable"/>
    </Style>

    <Style x:Key="Text.Secondary" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text}">
        <Setter Property="Foreground" Value="{StaticResource Foreground.Secondary}"/>
    </Style>

    <Style x:Key="Text.Muted" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text}">
        <Setter Property="Foreground" Value="{StaticResource Foreground.Muted}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Text.Header" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Text.Label" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text}">
        <Setter Property="Foreground" Value="{StaticResource Foreground.Secondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Text.Display" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="60"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Display" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#000000"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Height" Value="104"/>
    </Style>

    <Style x:Key="Icon" TargetType="{x:Type icon:MaterialIcon}">
        <Setter Property="Foreground" Value="{StaticResource Foreground.Primary}"/>
        <Setter Property="Height" Value="20"/>
    </Style>

    <Style x:Key="Icon.Logo" TargetType="{x:Type icon:MaterialIcon}" BasedOn="{StaticResource Icon}">
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Border Background="{StaticResource Border}" CornerRadius="3" Margin="2,0"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource Foreground.Secondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="14" Height="14" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource Border.Neutral}" Background="{StaticResource Background.Surface}" Margin="0,0,6,0">
                            <icon:MaterialIcon x:Name="Mark" Kind="Check" Width="12" Height="12" Foreground="{StaticResource Foreground.Primary}" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Background.Neutral}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="{StaticResource Background.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Foreground.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"></Setter>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8"
                Padding="{TemplateBinding Padding}">

                        <ContentPresenter
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Border.Neutral}"/>
                <Setter Property="Background" Value="{StaticResource Background.Neutral}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Foreground.Disabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>