<Window x:Class="DeskWatch.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeskWatch.Desktop"
        mc:Ignorable="d"
        Title="DeskWatch" Height="450" Width="800">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource Grid.Main}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="6*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Border.NavigationPanel}">
            <Grid Grid.Column="0" Style="{StaticResource Grid.Panel}"  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0">LOGO</TextBlock>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource TextBlock.Banner}" Text="DeskWatch"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource TextBlock.Hint}" Text="Device Control And Monitoring"/>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0, 16, 0, 16" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource Border.NavigationItem}">
                        <StackPanel VerticalAlignment="Center">
                            <Image Source=""></Image>
                            <TextBlock Text="Dashboard" Style="{StaticResource TextBlock.Navigation}"></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Border.NavigationItem}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Logs" Style="{StaticResource TextBlock.Navigation}"></TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0">
                        <Ellipse Height="12" Width="12" Fill="#20D6A0" Margin="0,0,8,0"></Ellipse>
                        <TextBlock Grid.Row="0" Style="{StaticResource TextBlock}" >Connection: Active</TextBlock>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource TextBlock.Hint}" Margin="20,0,0,0">Port: COM3 (9600)</TextBlock>
                </Grid>
            </Grid>
        </Border>
        
        <Grid Grid.Column="1">
        </Grid>
    </Grid>
</Window>
