<Window x:Class="DeskWatch.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeskWatch.Desktop"
        xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:controls="clr-namespace:DeskWatch.Desktop.Controls"
        xmlns:converters="clr-namespace:DeskWatch.Desktop.Converters"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Title="DeskWatch" Height="450" Width="800">

    <Window.Resources>
        <ResourceDictionary>
            
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:ConnectionStatusBadgeVariantConverter x:Key="ConnectionStatusBadgeVariantConverter"/>
            <converters:ConnectionStatusDeviceStatusConverter x:Key="ConnectionStatusDeviceStatusConverter"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource Panel.Main}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Section}">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <icons:MaterialIcon Kind="Monitor" Style="{StaticResource Icon.Logo}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource Text.Header}" Text="DeskWatch"></TextBlock>
                        <controls:Badge Variant="{Binding ConnectionStatus, Converter={StaticResource ConnectionStatusBadgeVariantConverter}}" Value="{Binding ConnectionStatus}"></controls:Badge>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" Text="v1.0.0"></TextBlock>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Section}">
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Text.Label}" Text="DEVICE STATUS"></TextBlock>

                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding ConnectionStatus, Converter={StaticResource ConnectionStatusDeviceStatusConverter}}" Style="{StaticResource Text}"/>
                        <!--<Border Grid.Column="1" Style="{StaticResource Badge.Success}" Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource Text.Success}" Text="READY"></TextBlock>
                        </Border>-->
                    </Grid>

                    <UniformGrid Grid.Row="2" Margin="4,8,0,0" Columns="3">
                        <StackPanel>
                            <TextBlock Grid.Column="0" Text="Serial Port" Style="{StaticResource Text.Label}"/>
                            <TextBlock Grid.Column="0" Text="{Binding Port}" Style="{StaticResource Text}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Grid.Column="0" Text="Last Update" Style="{StaticResource Text.Label}"/>
                            <TextBlock Grid.Column="0" Text="{Binding LastUpdated, StringFormat={}{0:HH:mm:ss.fff}}" Style="{StaticResource Text}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Grid.Column="0" Text="Firmware" Style="{StaticResource Text.Label}"/>
                            <TextBlock Grid.Column="0" Text="1.0.0" Style="{StaticResource Text}"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Section}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DEVICE INFORMATION" Style="{StaticResource Text.Label}"></TextBlock>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Clock time" Style="{StaticResource Text.Label}"></TextBlock>
                        <TextBlock Grid.Column="1" Text="09:20:14" Style="{StaticResource Text}"></TextBlock>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Device state" Style="{StaticResource Text.Label}"></TextBlock>
                        <TextBlock Grid.Column="1" Text="RUNNING" Style="{StaticResource Text}"></TextBlock>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Display" Style="{StaticResource Text.Label}"></TextBlock>
                        <TextBlock Grid.Column="1" Text="ACTIVE" Style="{StaticResource Text}"></TextBlock>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Synchronization" Style="{StaticResource Text.Label}"></TextBlock>
                        <!--<Border Grid.Column="1" Style="{StaticResource Badge.Success}" Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource Text.Success}" Text="SYNCED"></TextBlock>
                        </Border-->
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Section}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="2" Rows="2" Margin="0,0,0,4">

                        <Button Margin="0,0,4,4" Command="{Binding ConnectCommand}">
                            <StackPanel Orientation="Horizontal">
                                <icons:MaterialIcon Kind="LanConnect" Margin="0,0,4,0" Height="16"/>
                                <TextBlock Text="Connect"></TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,4,4" Command="{Binding DisconnectCommand}">
                            <StackPanel Orientation="Horizontal">
                                <icons:MaterialIcon Kind="LanDisconnect" Margin="0,0,4,0" Height="16"/>
                                <TextBlock Text="Disconnect"></TextBlock>
                            </StackPanel>
                        </Button>

                        <Button Margin="0,0,4,4">
                            <StackPanel Orientation="Horizontal">
                                <icons:MaterialIcon Kind="MoonWaningCrescent" Margin="0,0,4,0" Height="16"/>
                                <TextBlock Text="Sleep"></TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,4,4">
                            <StackPanel Orientation="Horizontal">
                                <icons:MaterialIcon Kind="WeatherSunny" Margin="0,0,4,0" Height="16"/>
                                <TextBlock Text="Wake Up"></TextBlock>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Button Margin="0,0,4,4"  Grid.Row="1" Command="{Binding SynchronizeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Kind="Sync" Margin="0,0,4,0" Height="16"/>
                            <TextBlock Text="Synchronize"></TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource Section}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Event Log" Style="{StaticResource Text.Label}" Margin="0,0,0,4"/>

                    <ListView Grid.Row="1" Background="Transparent" BorderThickness="0" Grid.IsSharedSizeScope="True" ItemsSource="{Binding Events}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto" SharedSizeGroup="timespan"/>
                                        <ColumnDefinition Width="auto" SharedSizeGroup="source"/>
                                        <ColumnDefinition Width="auto" SharedSizeGroup="event"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="12" Height="12" BorderThickness="2" CornerRadius="25" Padding="1">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="INF">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Foreground.Success}"/>
                                                    </DataTrigger>
                                                    
                                                    <DataTrigger Binding="{Binding Level}" Value="ERR">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Foreground.Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <Border CornerRadius="25">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="INF">
                                                            <Setter Property="Background" Value="{StaticResource Foreground.Success}"/>
                                                        </DataTrigger>
                                                        
                                                        <DataTrigger Binding="{Binding Level}" Value="ERR">
                                                            <Setter Property="Background" Value="{StaticResource Foreground.Danger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Border>

                                    <TextBlock Margin="8,0,0,0" Grid.Column="1" Text="{Binding Timestamp}" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}"/>
                                    <TextBlock Margin="16,0,0,0" Grid.Column="2" Text="{Binding Source}" VerticalAlignment="Center" Style="{StaticResource Text}"/>
                                    <TextBlock Margin="16,0,0,0" Grid.Column="3" Text="{Binding Event}" VerticalAlignment="Center" Style="{StaticResource Text}"/>
                                    <TextBlock Margin="16,0,0,0" Grid.Column="4" Text="{Binding Message}" VerticalAlignment="Center" Style="{StaticResource Text}"/>
                                </Grid>
                            </DataTemplate>                            
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>


            </Border>
        </Grid>
    </Border>
</Window>

