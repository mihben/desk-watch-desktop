<UserControl x:Class="DeskWatch.Desktop.Screens.DashboardScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DeskWatch.Desktop.Screens"
             xmlns:icon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Assets/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <icon:MaterialIcon Kind="WatchVariant" Height="48" Foreground="{StaticResource Icon}" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="1">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <TextBlock Text="DeskWatch" Style="{StaticResource TextBlock.Banner}"></TextBlock>
                        <Border CornerRadius="14"
                                Background="{StaticResource Status.Success}" Margin="4,0,0,0" Padding="8,4,8,4"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Online" Style="{StaticResource TextBlock}" Foreground="{StaticResource Text.Primary}" FontWeight="Bold"></TextBlock>
                        </Border>                        
                    </StackPanel>
                    <TextBlock Text="Device connected and running" Style="{StaticResource TextBlock.Hint}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Border Style="{StaticResource Border.Panel}" Padding="16">
                    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <icon:MaterialIcon Kind="CalendarTextOutline" Height="24" Foreground="{StaticResource Icon}" Margin="0,0,4,0"></icon:MaterialIcon>
                            <TextBlock Text="Event Log" Style="{StaticResource TextBlock}" FontWeight="Bold"></TextBlock>
                        </StackPanel>

                        
                    </StackPanel>                    
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
