<UserControl x:Class="DeskWatch.Desktop.Controls.Badge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DeskWatch.Desktop.Controls"
             x:Name="Root"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="Badge" TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="8,4,8,4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Variant, ElementName=Root}" Value="Neutral">
                        <Setter Property="Background" Value="{StaticResource Background.Neutral}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Border.Neutral}"/>
                    </DataTrigger>   
                    <DataTrigger Binding="{Binding Variant, ElementName=Root}" Value="Info">
                        <Setter Property="Background" Value="{StaticResource Background.Info}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Border.Info}"/>
                    </DataTrigger>   
                    <DataTrigger Binding="{Binding Variant, ElementName=Root}" Value="Success">
                        <Setter Property="Background" Value="{StaticResource Background.Success}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Border.Success}"/>
                    </DataTrigger>    
                    <DataTrigger Binding="{Binding Variant, ElementName=Root}" Value="Danger">
                        <Setter Property="Background" Value="{StaticResource Background.Danger}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Border.Danger}"/>
                    </DataTrigger>   
                </Style.Triggers>
            </Style>

            <Style x:Key="Badge.Text" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text}">
                <Setter Property="FontWeight" Value="Bold"/>

                <Style.Triggers>
                    <DataTrigger Binding="{Binding Variant, ElementName=Root}" Value="Neutral">
                        <Setter Property="Foreground" Value="{StaticResource Foreground.Neutral}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Variant, ElementName=Root}" Value="Info">
                        <Setter Property="Foreground" Value="{StaticResource Foreground.Info}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Variant, ElementName=Root}" Value="Success">
                        <Setter Property="Foreground" Value="{StaticResource Foreground.Success}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Variant, ElementName=Root}" Value="Danger">
                        <Setter Property="Foreground" Value="{StaticResource Foreground.Danger}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Assets/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Border Style="{StaticResource Badge}" Margin="4,0,0,0">
        <TextBlock Style="{StaticResource Badge.Text}" Text="{Binding ConnectionStatus}"></TextBlock>
    </Border>
</UserControl>
